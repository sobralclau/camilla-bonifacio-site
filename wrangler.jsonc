{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "camilla-bonifacio-site",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camilla-bonifacio-leads",
      "database_id": "31908b1f-05d3-41ad-8dc2-44d0896bf113"
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "camilla-bonifacio-preview",
        "database_id": "d3d2c490-db53-4ed7-9ba5-46dfbd3f0bb3"
      }
    ],
    "vars": {
      "CRM_TEST_MODE": "preview"
    }
  },
  "preview_urls": true
}
